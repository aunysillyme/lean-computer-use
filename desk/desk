#!/usr/bin/env python3
"""desk <bundle_id> <tool> ['<json>']: inject cached pid and window_id."""
import argparse
import json
import sys
from _resolve import DeskError, redact, run_tool, save_json


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("bundle_id")
    parser.add_argument("tool")
    parser.add_argument("args", nargs="?", default="{}")
    options = parser.parse_args()
    try:
        args = json.loads(options.args)
        if not isinstance(args, dict):
            raise ValueError("tool arguments must be a JSON object")
        rc, result, pid, wid, cached = run_tool(options.bundle_id, options.tool, args)
        path = save_json(result, prefix=options.tool)
        clean = redact(result)
        keep = {k: clean[k] for k in ("effect", "error", "message") if isinstance(clean, dict) and k in clean}
        print(json.dumps(redact({"tool": options.tool, "rc": rc, "pid": pid, "window_id": wid,
                                 "cached": cached, "file": str(path), **keep}), ensure_ascii=False))
        return rc or (1 if isinstance(result, dict) and result.get("error") else 0)
    except (DeskError, ValueError, OSError) as error:
        # JSON decode messages do not include the source document.
        print("desk: " + str(error).replace("\n", " "), file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
